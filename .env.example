# ========================================
# Database Configuration
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doctoralia_migration
DATABASE_URL=postgresql://postgres:postgres@db:5432/doctoralia_migration

# ========================================
# Scraping Configuration
# ========================================
# Comma-separated list of cities to scrape
SCRAPE_CITIES=Lima,Arequipa,Trujillo

# Comma-separated list of medical specialties
SCRAPE_SPECIALTIES=Medicina general,Pediatría,Dermatología,Cardiología

# Number of doctors to scrape per city/specialty combination
DOCTORS_PER_SEARCH=5

# ========================================
# Data Generation Configuration
# ========================================
# Number of fake patients to generate
PATIENTS_COUNT=100

# Percentage of availability slots to fill with appointments (0.0 to 1.0)
APPOINTMENT_FILL_RATE=0.7

# ========================================
# Playwright Configuration
# ========================================
# Run browser in headless mode (1 = true, 0 = false)
PLAYWRIGHT_HEADLESS=1

# Maximum concurrent scraping operations
MAX_CONCURRENCY=2

# Optional proxy configuration (format: http://user:pass@proxyprovider:port)
PROXY_URL=

# ========================================
# Pipeline Configuration
# ========================================
# Clear database before running pipeline (true/false)
CLEAR_DATABASE=true

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Node environment
NODE_ENV=production
